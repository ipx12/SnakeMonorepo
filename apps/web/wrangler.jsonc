{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snake-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "API",
      "service": "snakemonorepo"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_URL": "/api",
    "INTERNAL_API_URL": "https://snakemonorepo.ipx12.workers.dev"
  },
  "previews": {
    "vars": {
      "NEXT_PUBLIC_API_URL": "/api",
      "INTERNAL_API_URL": "https://snakemonorepo-previews.ipx12.workers.dev"
    }
  }
}
