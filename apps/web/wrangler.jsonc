{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snake-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "API",
      "service": "snakemonorepo"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_URL": "/api",
    "INTERNAL_API_URL": "https://snakemonorepo.ipx12.workers.dev"
  },
  "previews": {
    "vars": {
      "NEXT_PUBLIC_API_URL": "/api",
      "INTERNAL_API_URL": "https://snakemonorepo-previews.ipx12.workers.dev"
    }
  }
}
