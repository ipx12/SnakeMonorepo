{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snakemonorepo",
  "main": "src/worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "vars": {
    "NODE_ENV": "production",
    "BETTER_AUTH_URL": "https://snakemonorepo.ipx12.workers.dev",
    "DATABASE_URL": "libsql://tododb-sqldb.aws-eu-west-1.turso.io",
    "previews": {
      "ENVIRONMENT": "preview",
      "BETTER_AUTH_URL": "https://snakemonorepo-previews.ipx12.workers.dev",
      "DATABASE_URL": "libsql://tododb-previews.aws-eu-west-1.turso.io"
    }
  }
}